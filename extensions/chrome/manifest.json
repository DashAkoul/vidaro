{
  "manifest_version": 3,
  "name": "Vidaro YouTube Downloader",
  "version": "1.1.0",
  "description": "Download YouTube videos, playlists, and channels with Vidaro",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vidaro YouTube Downloader"
  },
  "web_accessible_resources": [{
    "resources": ["download-page.html", "download-page.js", "styles.css"],
    "matches": ["*://*.youtube.com/*"]
  }]
}