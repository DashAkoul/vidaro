{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vidaro",
  "version": "2.0.0",
  "identifier": "com.akoul.yt-downloader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vidaro",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://i.ytimg.com https://*.ytimg.com https://*.ggpht.com https://*.googleusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "../installer/nsis-header.bmp",
        "sidebarImage": "../installer/nsis-welcome.bmp"
      },
      "wix": {
        "bannerPath": "../installer/wix-banner.bmp",
        "dialogImagePath": "../installer/wix-dialog.bmp"
      }
    }
  }
}
